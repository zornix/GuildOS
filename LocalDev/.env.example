# ── Database ────────────────────────────────────────────────────
# Treasury V1 and prod run on Supabase. Point local dev at your real
# Supabase "demo" project (recommended), OR use the local Docker
# Postgres fallback (USE_DOCKER_DB=1, see the bottom of this file).
#
# How api/db.py chooses a client:
#   • DATABASE_URL set      → local psycopg shim (Docker fallback)
#   • DATABASE_URL empty +
#     SUPABASE_URL set      → supabase-py over PostgREST (the Supabase demo)
# So for the Supabase demo path, leave DATABASE_URL EMPTY.

# Supabase demo project — the app talks to this via supabase-py (PostgREST).
# Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://<your-demo-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Direct Postgres connection to the SAME demo project — used ONLY by
# scripts/migrate_db.py to apply numbered SQL migrations (tables, triggers,
# plpgsql RPC functions). Supabase Dashboard → Project Settings → Database →
# Connection string → "Session pooler" (or Direct connection).
# NOTE: do NOT also populate DATABASE_URL, or the app switches to the shim.
SUPABASE_DB_URL=postgresql://postgres.<your-demo-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Direct Postgres connection used by tests/treasury/conftest.py for raw-SQL /
# trigger / RPC / atomicity tests (superuser; bypasses RLS by design). Defaults to
# SUPABASE_DB_URL when unset. Point at the demo or a disposable local Postgres.
TEST_DATABASE_URL=postgresql://postgres.<your-demo-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── App ─────────────────────────────────────────────────────────
JWT_SECRET=local-dev-secret-key-change-in-prod
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:8001
CHECKIN_LINK_TTL_MINUTES=10

# Feature development flags
FEATURE_VP_OPERATIONS=1
FEATURE_SECRETARY_COMMS=1

# Secretary module defaults to dry-run providers locally
MESSAGE_DELIVERY_MODE=dry_run
ESCALATION_DELAY_MINUTES=120
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
MESSAGE_WEBHOOK_SECRET=local-webhook-secret-change-in-prod

# ── Local Docker Postgres fallback (optional, fully offline) ─────
# To develop without Supabase, run `USE_DOCKER_DB=1 bash deploy/local-dev.sh`
# and set DATABASE_URL below. When DATABASE_URL is set the app uses the local
# psycopg shim instead of Supabase (the shim mirrors the supabase-py API).
# DATABASE_URL=postgresql://fraternityos:localdev@localhost:5434/fraternityos
