# GuildOS backend configuration reference (tracked — never put real secrets here).
# Copy to .env for local development. All vars are read by api/config.py Settings
# unless noted. Production values live in Vercel project env vars.

# --- Database (ADR-0002: Supabase is hosted Postgres only; the app always talks
# --- direct psycopg2 over the pooler) ---
# Demo/local pooler URL. This is the database the app talks to; it is required
# (api/platform/db.py raises without it, and a deploy refuses to boot).
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# Used only by `npm run migrate:prod` (scripts/migrate_db.py --prod). Never read
# by the app.
# PROD_DATABASE_URL=
# Used only by pytest (tests/treasury/conftest.py). Usually same as DATABASE_URL.
# TEST_DATABASE_URL=

# --- Auth ---
# HS256 signing secret for member JWTs. Production refuses to boot if this is
# missing, short (<32 chars), or starts with "local-dev-secret" (api/index.py).
JWT_SECRET=local-dev-secret
# Allows POST /api/auth/dev-login. Must be unset/false in any deploy; the boot
# guard refuses production and preview when truthy.
DEV_AUTH_BYPASS=false

# --- URLs ---
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:8001

# --- Attendance ---
CHECKIN_LINK_TTL_MINUTES=10

# --- Cron (Vercel Cron sends "Authorization: Bearer $CRON_SECRET") ---
# Empty disables every /api/cron/* endpoint (401). Required non-empty in deploys.
CRON_SECRET=

# --- Outbound messages ---
# "dry_run": outbox rows are marked simulated, nothing is sent (local default).
# "twilio": real SMS via the Twilio REST API; requires the three TWILIO_* vars.
MESSAGE_DELIVERY_MODE=dry_run
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 sending number, e.g. +15551234567. Must be A2P 10DLC registered.
TWILIO_FROM_NUMBER=

# --- Observability ---
# Empty disables Sentry (local default).
SENTRY_DSN=

# --- Set by Vercel automatically; never set locally ---
# VERCEL_ENV=
