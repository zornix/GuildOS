{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/c/(.*)", "dest": "/api/index.py" }
  ],
  "crons": [
    {
      "path": "/api/cron/process-fines",
      "schedule": "*/15 * * * *"
    }
  ]
}
